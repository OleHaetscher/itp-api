{
  "caption": "Structured Analysis of Social Behavior (SASB): transitive and intransitive focus",
  "author": "Lorna Smith Benjamin",
  "version": "0.2.0",
  "stateSpaces": [
    {
      "caption": "SASB transitive focus state space",
      "abbreviation": "SASBT",
      "description": "Discretized version of the diamond-shaped interpersonal state space for the transitive focus of the Structured Analysis of Social Behavior (SASB). The space is organized by affiliation and interdependence, with the eight classical transitive SASB cluster labels 1-1 through 1-8 placed on the outer rhombus.",
      "type": "discrete",
      "coordinates": {
        "system": "cartesian",
        "dimensions": [
          {
            "caption": "Affiliation",
            "abbreviation": "Aff",
            "description": "Horizontal interpersonal dimension ranging from hostile or attacking behavior to loving or affiliative behavior.",
            "range": {
              "minimum": -2,
              "maximum": 2
            },
            "labels": {
              "-2": "maximally hostile",
              "0": "neutral affiliation",
              "2": "maximally loving"
            }
          },
          {
            "caption": "Interdependence",
            "abbreviation": "Int",
            "description": "Vertical interpersonal dimension ranging from controlling or managing behavior to emancipating or autonomy-granting behavior.",
            "range": {
              "minimum": -2,
              "maximum": 2
            },
            "labels": {
              "-2": "maximally controlling",
              "0": "neutral interdependence",
              "2": "maximally emancipating"
            }
          }
        ],
